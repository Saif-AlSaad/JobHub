# Server Environment Configuration
PROJECT_NAME="JOB HUB - AI-Powered Placement Platform"
ENVIRONMENT="development"
FRONTEND_URL="http://localhost:5173"

# Security & Tokens
JWT_SECRET="super-secret-key-job-hub-prototype-2026-secure-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="sqlite:///./job_hub.db"
# Supabase PostgreSQL Connection Pooler URI (Port 6543):
# DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require"

# Supabase API & Auth Configuration (from Supabase Dashboard -> Project Settings -> API)
# Backend:
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_JWT_SECRET=""

# Frontend (Vite):
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# AI & LLM Service Configuration
GEMINI_API_KEY=""

# Email Dispatch Provider (SMTP Simulation)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USERNAME="alerts@jobhub.io"
EMAIL_PASSWORD="secure_email_app_password"

# Matching Engine Initial Weights (Configurable)
WEIGHT_SEMANTIC=0.40
WEIGHT_SKILL=0.30
WEIGHT_EXP_EDU=0.15
WEIGHT_LOCATION=0.15
